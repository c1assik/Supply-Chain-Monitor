# Шаблон: скопировать в .env командой deploy/generate-env.sh, она заполнит пустые секреты.
# Настоящие значения никогда не коммитятся. В паролях допустимы только буквы и цифры:
# они подставляются в URL ниже.
POSTGRES_USER=scm
POSTGRES_DB=scm
POSTGRES_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=artifacts
GRAFANA_PASSWORD=

# Приложение вне Docker: те же значения, адреса localhost.
SCM_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
SCM_REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0
SCM_S3_ENDPOINT=http://localhost:8333
SCM_S3_ACCESS_KEY=${S3_ACCESS_KEY}
SCM_S3_SECRET_KEY=${S3_SECRET_KEY}
SCM_S3_BUCKET=${S3_BUCKET}
SCM_SCORING_CONFIG_PATH=config/scoring.yaml

# Без этих двух значений алерты пишутся в лог воркера.
SCM_TELEGRAM_TOKEN=
SCM_TELEGRAM_CHAT_ID=
# Адрес дашборда для ссылок в алертах.
SCM_DASHBOARD_URL=http://localhost:8000
