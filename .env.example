# Скопировать в .env. Значения по умолчанию только для локальной разработки.
POSTGRES_USER=scm
POSTGRES_PASSWORD=scm
POSTGRES_DB=scm
S3_ACCESS_KEY=scm-dev
S3_SECRET_KEY=scm-dev-secret
S3_BUCKET=artifacts

SCM_DATABASE_URL=postgresql+psycopg://scm:scm@localhost:5432/scm
SCM_SCORING_CONFIG_PATH=config/scoring.yaml
